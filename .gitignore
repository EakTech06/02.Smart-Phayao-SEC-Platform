# ค่าเฉพาะเครื่อง / ความลับ (ใช้ config/local.example.php เป็นต้นแบบ)
config/local.php

# Composer
/vendor/

# Log และไฟล์ที่ผู้ใช้อัปโหลด
storage/logs/*
!storage/logs/.gitkeep
# ไฟล์งานวิจัย/สื่อนวัตกรรมที่ครูอัปโหลด (อาจมีข้อมูลผู้เรียน)
storage/research/*
!storage/research/.gitkeep
# ภาพลายเซ็นของผู้ใช้ (ใช้ประทับเอกสารเท่านั้น)
storage/signatures/*
!storage/signatures/.gitkeep
# ฟอนต์ภาษาไทยสำหรับประทับลายเซ็น (วางเองต่อเครื่อง ดู resources/fonts/README.md)
resources/fonts/*.ttf
public/uploads/*
!public/uploads/avatars/
public/uploads/avatars/*
!public/uploads/avatars/.gitkeep
!public/uploads/branding/
public/uploads/branding/*
!public/uploads/branding/.gitkeep

# เอกสารต้นทาง/ข้อมูลบุคลากร (มีข้อมูลส่วนบุคคล — PDPA) ไม่เก็บใน Git
/ข้อมูล/

# OS / Editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
